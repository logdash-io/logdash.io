{
  "name": "@logdash/hyper-ui",
  "version": "0.1.0",
  "private": true,
  "description": "LogDash design system components and utilities built for Svelte 5 and Tailwind CSS",
  "type": "module",
  "main": "./src/lib/index.ts",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": "./src/lib/index.ts",
    "./styles": "./src/lib/styles/main.css",
    "./styles/*": "./src/lib/styles/*.css",
    "./features": "./src/lib/features/index.ts",
    "./presentational": "./src/lib/presentational/index.ts",
    "./icons": "./src/lib/icons/index.ts",
    "./utils": "./src/lib/utils/index.ts",
    "./features/*": "./src/lib/features/*.ts",
    "./presentational/*": "./src/lib/presentational/*.ts",
    "./utils/*": "./src/lib/utils/*.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "echo 'Internal workspace package - no build needed'",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync || echo ''"
  },
  "keywords": [
    "design-system",
    "ui",
    "components",
    "svelte",
    "tailwind",
    "logdash"
  ],
  "author": "LogDash Team",
  "license": "MIT",
  "dependencies": {
    "@logdash/status": "workspace:*",
    "ts-pattern": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "peerDependencies": {
    "@sveltejs/kit": "*",
    "@sveltejs/vite-plugin-svelte": "*",
    "svelte": "*",
    "svelte-check": "*",
    "tailwindcss": "*",
    "typescript": "*",
    "vite": "*"
  }
}
