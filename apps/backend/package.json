{
  "name": "starter",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "stripe": "stripe listen --forward-to localhost:3000/payments/stripe/webhook",
    "migrate-up": "npx migrate-mongo up",
    "migrate-clickhouse": "dotenv -e .env -- clickhouse-migrations migrate"
  },
  "dependencies": {
    "@clickhouse/client": "^1.15.0",
    "@logdash/node": "^1.0.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@redis/client": "^5.10.0",
    "axios": "^1.18.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express-basic-auth": "^1.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.7.2",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.2",
    "stripe": "^20.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.19",
    "@testcontainers/clickhouse": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.3",
    "clickhouse-migrations": "^1.1.1",
    "dotenv-cli": "^8.0.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-date-mock": "^1.0.10",
    "mongodb": "^7.0.0",
    "mongodb-memory-server": "^11.0.1",
    "nock": "^14.0.10",
    "prettier": "^3.7.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "@grpc/grpc-js": "1.13.5",
    "@protobufjs/utf8": "1.1.1",
    "@sveltejs/kit": "2.70.2",
    "@xhmikosr/decompress": "10.2.1",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5",
    "form-data": "4.0.6",
    "immutable": "5.1.8",
    "js-yaml": "4.3.1",
    "multer": "2.2.0",
    "nanoid": "3.3.18",
    "piscina": "4.9.3",
    "postcss": "8.5.23",
    "protobufjs": "7.6.5",
    "qs": "6.15.2",
    "rollup": "4.59.0",
    "sharp": "0.35.0",
    "svix": "1.92.2",
    "tar": "7.5.21",
    "tmp": "0.2.7",
    "undici": "7.29.0",
    "uuid": "11.1.1",
    "vite": "7.3.5",
    "ws": "8.21.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/utils/setup-env.ts",
      "jest-date-mock"
    ],
    "globalSetup": "<rootDir>/test/utils/global-setup.ts",
    "globalTeardown": "<rootDir>/test/utils/global-teardown.ts",
    "moduleNameMapper": {
      "^@logdash/node$": "<rootDir>/test/__mocks__/@logdash/node.ts",
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "testTimeout": 30000
  }
}
