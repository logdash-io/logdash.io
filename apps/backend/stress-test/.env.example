# Copy to `.env` and fill in. `.env` is gitignored - never commit real keys.
# This repository is public: any API key committed here is live and must be revoked.

# Project API key used to ingest logs/metrics. Create a throwaway project for stress
# testing rather than reusing a real one.
LOGDASH_API_KEY=

# Optional. Second project API key, for scripts that write to two projects at once.
LOGDASH_API_KEY_SECONDARY=

# Optional. Defaults to https://api.logdash.io. Point at a local backend to avoid
# hammering production.
# LOGDASH_API_HOST=http://localhost:3000
